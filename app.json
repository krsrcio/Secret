{
  "expo": {
    "name": "Secret",
    "slug": "secret-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#D1CFE8"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Secret to use your photos for your profile picture and posts."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Secret to record voice messages."
        }
      ],
      "expo-asset"
    ]
  }
}
